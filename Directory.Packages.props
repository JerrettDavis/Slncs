    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="System.Collections.Immutable" Version="11.0.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="TinyBDD.Xunit" Version="0.19.48" />
